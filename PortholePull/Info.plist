<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PortholeAppGroup</key>
	<string>$(PORTHOLE_APP_GROUP)</string>
	<key>PortholeWidgetAppGroup</key>
	<string>$(PORTHOLE_WIDGET_APP_GROUP)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Porthole</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).widget</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>porthole-widget</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>PortholeDeviceNameEntitlementsSuffix</key>
	<string>$(PORTHOLE_DEVICE_NAME_ENTITLEMENTS_SUFFIX)</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Porthole uses your local network to connect to your PC for screen sharing, file transfers, and clipboard synchronization.</string>
	<key>NSCameraUsageDescription</key>
	<string>Porthole uses the camera to scan the connection QR code displayed on your PC.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Porthole saves received photos and videos to your photo library when you select Save to Photos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Porthole accesses your photo library to identify photos and videos displayed on your PC and to send the photos and videos you choose to your PC.</string>
	<key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>local.porthole.pull.send.*</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
